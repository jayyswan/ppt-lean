import Pptc.Taylor.Lift

/-! # The Taylor hypothesis hierarchy and the conditional main theorem

This file is task **T2** of `notes/algebraic/PLAN-taylor-lean.md`.  The lift theorem
`Pptc.Taylor.Lift.TrinomialLift.Pconstructible` turns *any* hypothesis of the form
"the trinomial surface has a point whose coordinates lie in a class `Coord` of
P-constructible reals" into `PConstructible β`.  The only remaining input is the
**existence** of such a point, which is the geometric/arithmetic part of the
programme and is deliberately left open here.

* §1 defines the point-existence predicates `SR`, `SR_8`, `SR_quad`, `SR_tower`,
  `SR_F` (and later `SR_tot`), each as `Nonempty (TrinomialLift Coord β)` for the
  corresponding coordinate class, together with the hypothesis `TaylorTrinomial`
  of the plan (§1.2), which asks for such a point over `SolvableReal` for every
  real algebraic `β`.
* §2 proves that a lift can be re-read in any *larger* coordinate class
  (`TrinomialLift.mono`).
* §3 records the inclusions between the coordinate classes
  (`DegreeLE2Real → DegreeLE8Real → PTowerReal`, `SolvableReal → PTowerReal`).
* §4 derives the implication diagram of the plan (§5) as formal Lean lemmas:
  `SR_quad → SR_8 → SR_tower → P`, `SR → SR_tower → P`, and the tautological
  row `SR_F → P`.  The missing arrow `SR_F → SR` is *not* formal: `FReal` only
  knows that the coordinates are algebraic and P-constructible, not that they
  admit a solvable defining polynomial.
* §5 states the unconditional-looking main theorem
  `realAlgebraic_Pconstructible_of_taylorTrinomial` and its analogues for each
  weaker hypothesis: all of them are conditional on the corresponding
  point-existence hypothesis.
* §6 models the "trinomial field" row `SR_tot` over `K_tr,solv = Q^tr ∩ Q^solv`.
  Only `SR_tot → SR` is formal; the reverse direction (`SR → SR_tot`) would need
  every solvable real algebraic number to lie in the field generated by roots of
  rational trinomials, which is not available.

Nothing in this file proves Taylor's question, the geometry of the trinomial
surface, or PSC; see `notes/algebraic/PLAN-taylor-lean.md` §5 for the hypothesis
table.
-/

namespace Pconstructible

open Polynomial

-- The plan mandates the names `SR.Pconstructible`, `SR_F.Pconstructible`, …,
-- whose namespace repeats the ambient namespace; that is not a mistake here.
set_option linter.dupNamespace false

noncomputable section

/-! ### 1. The point-existence predicates -/

/-- Taylor's question restricted to the trinomial surfaces: every real algebraic `β` has a
trinomial lift whose coordinates are solvable real algebraic numbers. -/
def TaylorTrinomial : Prop :=
  ∀ β : ℝ, IsAlgebraic ℚ β → Nonempty (TrinomialLift SolvableReal β)

/-- `SR`: a point of the trinomial surface over `K_solv = Q^solv ∩ ℝ`. -/
def SR (β : ℝ) : Prop := Nonempty (TrinomialLift SolvableReal β)

/-- `SR_8`: a point over real algebraic coordinates of degree ≤ 8. -/
def SR_8 (β : ℝ) : Prop := Nonempty (TrinomialLift DegreeLE8Real β)

/-- `SR_quad`: a point over real quadratic coordinates. -/
def SR_quad (β : ℝ) : Prop := Nonempty (TrinomialLift DegreeLE2Real β)

/-- `SR_tower`: a point over the P-constructible root tower. -/
def SR_tower (β : ℝ) : Prop := Nonempty (TrinomialLift PTowerReal β)

/-- `F = P ∩ R_alg`: numbers that are P-constructible and algebraic. -/
def FReal (x : ℝ) : Prop := PConstructible x ∧ IsAlgebraic ℚ x

/-- `SR_F`: a point over `F` (the tautological row of the hierarchy). -/
def SR_F (β : ℝ) : Prop := Nonempty (TrinomialLift FReal β)

/-! ### 2. Monotonicity of the lift in the coordinate class -/

/-- A `TrinomialLift` can be re-read in any larger coordinate class. -/
def TrinomialLift.mono {Coord Coord' : ℝ → Prop} (h : ∀ x, Coord x → Coord' x)
    {β : ℝ} (hl : TrinomialLift Coord β) : TrinomialLift Coord' β where
  D := hl.D
  hD := hl.hD
  a := hl.a
  b := hl.b
  x₀ := hl.x₀
  c := hl.c
  q := hl.q
  T := hl.T
  y₀ := hl.y₀
  ha := h _ hl.ha
  hb := h _ hl.hb
  hx₀ := h _ hl.hx₀
  hT := fun i => h _ (hl.hT i)
  hroot := hl.hroot
  hq := hl.hq
  hqy := hl.hqy
  hq_sep := hl.hq_sep
  hxT := hl.hxT
  hinj := hl.hinj
  hβ := hl.hβ

/-! ### 3. Inclusions between the coordinate classes -/

/-- A solvable real algebraic number lies in the P-constructible root tower. -/
theorem SolvableReal.toPTowerReal {x : ℝ} (h : SolvableReal x) : PTowerReal x := by
  obtain ⟨q, hq, hsol, hx⟩ := h
  exact PTowerReal.solvable hq hsol hx

/-- A real quadratic number has degree at most 8. -/
theorem DegreeLE2Real.toDegreeLE8Real {x : ℝ} (h : DegreeLE2Real x) : DegreeLE8Real x := by
  obtain ⟨q, hq, hdeg, hx⟩ := h
  exact ⟨q, hq, by omega, hx⟩

/-- A real algebraic number of degree at most 8 lies in the P-constructible root tower.

This mirrors `DegreeLE8Real.Pconstructible`: the defining rational polynomial `q` is
mapped to `ℝ`, where every coefficient is rational and hence in `PTowerReal`, and
`PTowerReal.root8` then places the root `x` in the tower. -/
theorem DegreeLE8Real.toPTowerReal {x : ℝ} (h : DegreeLE8Real x) : PTowerReal x := by
  obtain ⟨q, hq, hdeg, hx⟩ := h
  have hq' : q.map (algebraMap ℚ ℝ) ≠ 0 := Polynomial.map_ne_zero hq
  have hdeg' : (q.map (algebraMap ℚ ℝ)).natDegree ≤ 8 :=
    (Polynomial.natDegree_map_le).trans hdeg
  have hcoeff : ∀ i, PTowerReal ((q.map (algebraMap ℚ ℝ)).coeff i) := by
    intro i
    rw [Polynomial.coeff_map]
    exact PTowerReal.rat (q.coeff i)
  have hx' : (q.map (algebraMap ℚ ℝ)).eval x = 0 := by
    rw [← Polynomial.eval₂_eq_eval_map]
    exact hx
  exact PTowerReal.root8 hq' hdeg' hcoeff hx'

/-- Membership in `FReal` gives P-constructibility. -/
theorem FReal.Pconstructible {x : ℝ} (h : FReal x) : PConstructible x := h.1

/-! ### 4. The formal implications of the hierarchy -/

/-- A quadratic point is a degree-≤8 point. -/
theorem SR_quad.toSR_8 {β : ℝ} (h : SR_quad β) : SR_8 β :=
  h.map (TrinomialLift.mono fun _ hx => DegreeLE2Real.toDegreeLE8Real hx)

/-- A degree-≤8 point is a point over the P-constructible root tower. -/
theorem SR_8.toSR_tower {β : ℝ} (h : SR_8 β) : SR_tower β :=
  h.map (TrinomialLift.mono fun _ hx => DegreeLE8Real.toPTowerReal hx)

/-- A point over `K_solv` is a point over the P-constructible root tower. -/
theorem SR.toSR_tower {β : ℝ} (h : SR β) : SR_tower β :=
  h.map (TrinomialLift.mono fun _ hx => SolvableReal.toPTowerReal hx)

/-- A point over `F = P ∩ R_alg` makes `β` P-constructible. -/
theorem SR_F.toP {β : ℝ} (h : SR_F β) : PConstructible β := by
  obtain ⟨hl⟩ := h
  exact hl.Pconstructible fun _ hx => FReal.Pconstructible hx

/-- A point over `K_solv` makes `β` P-constructible, via the recovery theorem. -/
theorem SR.Pconstructible {β : ℝ} (h : SR β) : PConstructible β := by
  obtain ⟨hl⟩ := h
  exact hl.Pconstructible fun _ hx => SolvableReal.Pconstructible hx

/-- A degree-≤8 point makes `β` P-constructible. -/
theorem SR_8.Pconstructible {β : ℝ} (h : SR_8 β) : PConstructible β := by
  obtain ⟨hl⟩ := h
  exact hl.Pconstructible fun _ hx => DegreeLE8Real.Pconstructible hx

/-- A real quadratic point makes `β` P-constructible. -/
theorem SR_quad.Pconstructible {β : ℝ} (h : SR_quad β) : PConstructible β := by
  obtain ⟨hl⟩ := h
  exact hl.Pconstructible fun _ hx => DegreeLE2Real.Pconstructible hx

/-- A point over the P-constructible root tower makes `β` P-constructible. -/
theorem SR_tower.Pconstructible {β : ℝ} (h : SR_tower β) : PConstructible β := by
  obtain ⟨hl⟩ := h
  exact hl.Pconstructible fun _ hx => PTowerReal.Pconstructible hx

/-- A point over `F = P ∩ R_alg` makes `β` P-constructible. -/
theorem SR_F.Pconstructible {β : ℝ} (h : SR_F β) : PConstructible β :=
  SR_F.toP h

/-! ### 5. The unconditional-looking conditional theorems -/

/-- Every real algebraic number is P-constructible, conditional on Taylor's question for the
trinomial surfaces. -/
theorem realAlgebraic_Pconstructible_of_taylorTrinomial (hTaylor : TaylorTrinomial) :
    ∀ β : ℝ, IsAlgebraic ℚ β → PConstructible β := by
  intro β hβ
  exact SR.Pconstructible (hTaylor β hβ)

/-- The same conclusion from `SR` alone (a point over `K_solv`, weaker than Taylor). -/
theorem realAlgebraic_Pconstructible_of_SR
    (h : ∀ β : ℝ, IsAlgebraic ℚ β → SR β) : ∀ β : ℝ, IsAlgebraic ℚ β → PConstructible β := by
  intro β hβ
  exact SR.Pconstructible (h β hβ)

/-- The same conclusion from `SR_8` alone. -/
theorem realAlgebraic_Pconstructible_of_SR_8
    (h : ∀ β : ℝ, IsAlgebraic ℚ β → SR_8 β) : ∀ β : ℝ, IsAlgebraic ℚ β → PConstructible β := by
  intro β hβ
  exact SR_8.Pconstructible (h β hβ)

/-- The same conclusion from `SR_quad` alone. -/
theorem realAlgebraic_Pconstructible_of_SR_quad
    (h : ∀ β : ℝ, IsAlgebraic ℚ β → SR_quad β) :
    ∀ β : ℝ, IsAlgebraic ℚ β → PConstructible β := by
  intro β hβ
  exact SR_quad.Pconstructible (h β hβ)

/-- The same conclusion from `SR_tower` alone. -/
theorem realAlgebraic_Pconstructible_of_SR_tower
    (h : ∀ β : ℝ, IsAlgebraic ℚ β → SR_tower β) :
    ∀ β : ℝ, IsAlgebraic ℚ β → PConstructible β := by
  intro β hβ
  exact SR_tower.Pconstructible (h β hβ)

/-- The same conclusion from `SR_F` alone. -/
theorem realAlgebraic_Pconstructible_of_SR_F
    (h : ∀ β : ℝ, IsAlgebraic ℚ β → SR_F β) : ∀ β : ℝ, IsAlgebraic ℚ β → PConstructible β := by
  intro β hβ
  exact SR_F.Pconstructible (h β hβ)

/-! ### 6. The "trinomial field" row `SR_tot` -/

/-- The field generated by the roots of rational trinomials `X ^ n + a * X + b`. -/
inductive TrinomialReal : ℝ → Prop
  /-- Every rational number lies in the trinomial field. -/
  | rat (q : ℚ) : TrinomialReal (q : ℝ)
  /-- A real root of a rational trinomial `X ^ n + a * X + b` with `0 < n` lies in the
  trinomial field. -/
  | root {n : ℕ} (hn : 0 < n) {a b : ℚ} {x : ℝ} (hx : x ^ n + a * x + b = 0) :
      TrinomialReal x
  /-- The trinomial field is closed under addition. -/
  | add {x y} : TrinomialReal x → TrinomialReal y → TrinomialReal (x + y)
  /-- The trinomial field is closed under negation. -/
  | neg {x} : TrinomialReal x → TrinomialReal (-x)
  /-- The trinomial field is closed under multiplication. -/
  | mul {x y} : TrinomialReal x → TrinomialReal y → TrinomialReal (x * y)
  /-- The trinomial field is closed under inversion. -/
  | inv {x} : TrinomialReal x → TrinomialReal (x⁻¹)

/-- `K_tr,solv = Q^tr ∩ Q^solv`. -/
def KTrSolvReal (x : ℝ) : Prop := TrinomialReal x ∧ SolvableReal x

/-- `SR_tot`: a point of the trinomial surface over `K_tr,solv = Q^tr ∩ Q^solv`. -/
def SR_tot (β : ℝ) : Prop := Nonempty (TrinomialLift KTrSolvReal β)

/-- `K_tr,solv ⊆ K_solv`, so a point over `K_tr,solv` is a point over `K_solv`. -/
theorem SR_tot.toSR {β : ℝ} (h : SR_tot β) : SR β :=
  h.map (TrinomialLift.mono fun _ hx => hx.2)

/-- A point over `K_tr,solv` makes `β` P-constructible. -/
theorem SR_tot.Pconstructible {β : ℝ} (h : SR_tot β) : PConstructible β := by
  obtain ⟨hl⟩ := h
  exact hl.Pconstructible fun _ hx => SolvableReal.Pconstructible hx.2

end

end Pconstructible
