\\ Engine O (session 38): h = x^3 + a*x + b, U = e1(F) - c^2. Weighted homogeneous, weights x,U:1 a:2 b:3.
\\ F_{h,U} = G/Bu, c^2 = -Au/Bu, G = Bu*x^9 + sum_k (-1)^k E_k x^(9-k) (B*e_k). Load with run_read.py or line by line.
Au=U^6+1278*a*U^4+50274*b*U^3+3321*a^2*U^2+2357586*a*b*U-1822500*a^3+6751269*b^2;
Bu=U^5+1296*a*U^3+50112*b*U^2+27648*a^2*U+2985984*a*b;
E1=18*a*U^4 - 162*b*U^3 + 24327*a^2*U^2 + 628398*b*a*U + (1822500*a^3 - 6751269*b^2);
E2=3*a*U^5 - 54*b*U^4 + 4221*a^2*U^3 + 59130*b*a*U^2 + (524556*a^3 - 2250423*b^2)*U - 8957952*b*a^2;
E3=-3*b*U^5 + 30*a^2*U^4 - 6588*b*a*U^3 + (39420*a^3 - 89586*b^2)*U^2 - 2775384*b*a^2*U + (-1458000*a^4 + 17942148*b^2*a);
E4=3*a^2*U^5 - 144*b*a*U^4 + (3879*a^3 + 3969*b^2)*U^3 - 80730*b*a^2*U^2 + (-143532*a^4 + 3679263*b^2*a)*U + (9284544*b*a^3 - 15431472*b^3);
E5=-6*b*a*U^5 + (6*a^3 + 108*b^2)*U^4 - 9711*b*a^2*U^3 + (-1566*a^4 + 76140*b^2*a)*U^2 + (309744*b*a^3 - 3536379*b^3)*U + (48600*a^5 - 18812574*b^2*a^2);
E6=(a^3 + 3*b^2)*U^5 - 78*b*a^2*U^4 + (999*a^4 + 10179*b^2*a)*U^3 + (21870*b*a^3 - 80514*b^3)*U^2 + (-37260*a^5 - 1437993*b^2*a^2)*U + (933120*b*a^4 + 18615744*b^3*a);
E7=-3*b*a^2*U^5 + (-6*a^4 + 126*b^2*a)*U^4 + (-2610*b*a^3 - 3807*b^3)*U^3 + (-2484*a^5 - 83322*b^2*a^2)*U^2 + (-24624*b*a^4 + 1433214*b^3*a)*U + (97200*a^6 - 1606716*b^2*a^3 - 8817984*b^4);
E8=3*b^2*a*U^5 + (12*b*a^3 - 54*b^3)*U^4 + (45*a^5 + 2898*b^2*a^2)*U^3 + (3618*b*a^4 + 83430*b^3*a)*U^2 + (-1620*a^6 + 9153*b^2*a^3 - 1102248*b^4)*U + (-77760*b*a^5 + 1434672*b^3*a^2);
E9=-b^3*U^5 - 6*b^2*a^2*U^4 + (-45*b*a^4 - 1242*b^3*a)*U^3 + (-225*a^6 - 5184*b^2*a^3 - 44037*b^4)*U^2 + (-7830*b*a^5 - 109539*b^3*a^2)*U + (8100*a^7 + 83835*b^2*a^4 - 571536*b^4*a);
G=Bu*x^9+sum(k=1,9,(-1)^k*eval(Str("E",k))*x^(9-k));
\\ check: G_5 = coefficient of U^5 = (x^3+a*x+b)^3
polcoef(G,5,U)==(x^3+a*x+b)^3
